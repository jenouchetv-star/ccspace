        {
          "id": "ly-mig-30",
          "type": "text",
          "content": "They folded a new plane together — Zech's neat, pointed nose, Corey's broad, balanced wings. On the third try, it glided all the way to the treehouse.",
          "x": 10,
          "y": 35,
          "w": 80,
          "h": 25,
          "style": "body",
