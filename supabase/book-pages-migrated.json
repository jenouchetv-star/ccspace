      "background": {
        "type": "color",
        "value": "#FEF1E3"
      },
      "layers": [
        {
          "id": "ly-mig-42",
          "type": "text",
          "content": "“I worked so hard on it,” Mateo said. “I do not want to change my design.”",
          "x": 10,
          "y": 35,
          "w": 80,
          "h": 25,
          "style": "body",
          "align": "left",
          "color": "",
          "locked": false
