      },
      "layers": [
        {
          "id": "ly-mig-47",
          "type": "text",
          "content": "Two tube towers, a wider piece of cardboard, and a box underneath — this time the bridge held a whole row of toy cars.",
          "x": 10,
          "y": 35,
          "w": 80,
          "h": 25,
          "style": "body",
          "align": "left",
          "color": "",
          "locked": false
