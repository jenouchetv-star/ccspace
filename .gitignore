# Database backups: real data snapshots, not source - keep them out of version control.
supabase/backups/

# Local Claude Code tooling config - not part of the deployed site.
.claude/settings.local.json
.claude_scratch_bak/

# Windows folder metadata.
desktop.ini

# Local brainstorming-session mockups - not project source.
.superpowers/

# Local git worktrees used for isolated feature development.
.worktrees/

# Wrangler's local dev cache (created by `wrangler pages dev` for testing
# the functions/ directory) - a build artifact, not source.
.wrangler/

# npm dependencies (currently just the Vitest test runner, see package.json)
# - installed from package-lock.json, never committed.
node_modules/

# Real secret values, if a local .env is ever used for one of the scripts
# in supabase/ - see .env.example for what belongs in it and where each
# variable actually gets set (Supabase secrets, Wrangler secrets, or a
# script's own shell environment).
.env
.env.local

