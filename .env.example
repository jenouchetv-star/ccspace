# Chike's Creative Space - environment variable reference
#
# There is no single running server here to hand this file to: index.html
# is a static build with no server-side env of its own, and every variable
# below belongs to one independently-deployed Supabase Edge Function, one
# Cloudflare Worker, or one locally-run Node script - each with its own
# real secret store. This file is the one place that lists all of them in
# one glance; copy each value into the store named next to it, never into
# a committed file. Add real values to a local .env only for tooling that
# reads one (none of this project's own scripts do today), and keep any
# such file out of git - see .gitignore.
#
# Supabase Edge Functions - set with:
#   npx supabase functions deploy <name>
#   npx supabase secrets set NAME=value
# (or Studio -> Edge Functions -> <name> -> Secrets)
# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are
# auto-injected into EVERY Edge Function by Supabase itself - never set
# these three by hand for a function, only for the Node script below.

# --- submit-ticket (Grown-Ups contact, business inquiry, report-a-problem) ---
TURNSTILE_SECRET=                    # Cloudflare Turnstile secret key - dash.cloudflare.com/*/turnstile

# --- notify (fired by Postgres triggers on new tickets/subscribers - never called from the browser) ---
RESEND_API_KEY=                      # from resend.com, once your sending domain is verified
RESEND_FROM=hello@example.com        # the verified "from" address
ADMIN_NOTIFY_EMAIL=                  # where new-ticket alerts go - defaults to RESEND_FROM if unset
WEBHOOK_SECRET=                      # random string you make up - must match the trigger SQL in migration.sql

# --- send-newsletter / send-scheduled-newsletters ---
# (RESEND_API_KEY, RESEND_FROM - same two as notify, above)
# (WEBHOOK_SECRET - send-scheduled-newsletters only, same value as notify's, above)
SITE_URL=https://www.example.com     # fallback origin for unsubscribe/accept-invite links

# --- get-site-analytics (proxies Cloudflare's GraphQL Analytics API into /admin) ---
CLOUDFLARE_API_TOKEN=                # Account API Token, Account Analytics:Read only, this account only
CLOUDFLARE_ACCOUNT_ID=               # your Cloudflare account id
CLOUDFLARE_SITE_TAG=                 # the token in the Web Analytics beacon's data-cf-beacon (see index.html)

# Node scripts - run locally, read from your own shell environment, not
# from this file (none of these scripts load dotenv):
#   SUPABASE_SERVICE_ROLE_KEY=... node supabase/generate-recovery-link.mjs
SUPABASE_SERVICE_ROLE_KEY=           # generate-recovery-link.mjs only - never commit a real value anywhere

# Cloudflare Worker (workers/media-upload) - NOT read from this file, set with:
#   npx wrangler secret put SUPABASE_URL
#   npx wrangler secret put SUPABASE_ANON_KEY
# PUBLIC_BASE_URL is a plain (non-secret) var, already documented with a
# placeholder directly in workers/media-upload/wrangler.toml.
