# Cloudflare Pages direct-upload exclusions (gitignore-style syntax).
# Keeps the deployed site to just what the app actually serves - none of
# this is needed by, or safe to expose alongside, the live site.

# Dev-only tooling, not part of the served site.
.claude/
.claude_scratch_bak/

# Backend config, Edge Function source, deploy scripts, and seed/backup
# data - lives in Supabase, not on the static host. supabase/backups/ in
# particular can contain real subscriber/ticket data pulled from the live
# project and must never be published.
supabase/

# Internal planning docs, not site content.
Chikes_Creative_Space_PWA_Mobile_Implementation.md
Chikes_Creative_Space_Content_Inventory_Updated.md
MAINTENANCE.md

# Windows folder-view metadata, and a couple of unreferenced stray files
# sitting at the project root.
desktop.ini
assets/hero/desktop.ini
qt=q_95.webp
image 34.png

# Local git tooling config - meaningless without a .git directory here,
# and not something the deployed site needs either way.
.gitignore
