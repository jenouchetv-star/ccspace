# Cloudflare Pages reads this file and applies these headers to every
# response it serves - see https://developers.cloudflare.com/pages/configuration/headers/
#
# Scope: this only covers what THIS repo controls. It does not know what,
# if anything, Cloudflare Pages already sets by default for this project,
# or what any CDN/WAF rule in front of it adds - that's a hosting-dashboard
# question, not a code one. These four are safe defaults regardless:
# Pages always serves over HTTPS, so HSTS costs nothing to add; nothing on
# this site is meant to be framed by another origin; and neither
# Referrer-Policy nor X-Content-Type-Options change any current behavior,
# they only remove ambiguity a browser would otherwise fill in itself.
/*
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Report-Only, deliberately not enforced yet: this app talks to enough
  # real third-party origins (Supabase, Cloudflare Turnstile/Insights, the
  # unpkg.com CDN fallback for Lucide/Supabase's own JS, Google Fonts,
  # YouTube embeds) that shipping a blocking policy without first watching
  # for violations risks breaking the live site in a way nothing in this
  # repo can test ahead of time. This logs what an enforcing policy WOULD
  # have blocked, in each visitor's own browser console, with nothing
  # actually blocked - watch for violations for a while, then switch this
  # header's name to Content-Security-Policy (dropping "-Report-Only")
  # once none show up from normal use.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://unpkg.com https://challenges.cloudflare.com https://static.cloudflareinsights.com 'unsafe-inline'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://wdctkfhwygwwulipwnys.supabase.co wss://wdctkfhwygwwulipwnys.supabase.co https://cloudflareinsights.com https://static.cloudflareinsights.com; frame-src https://challenges.cloudflare.com https://www.youtube.com https://www.youtube-nocookie.com; base-uri 'self'; form-action 'self' https://challenges.cloudflare.com; object-src 'none'
